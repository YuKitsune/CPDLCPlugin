@inject IServerSettingsProvider SettingsProvider
@{
    var branding = await SettingsProvider.LoadBranding(Context.RequestAborted);
}
@* For the pages without the sidebar: login, setup and plugin authorization *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - @branding.ServerName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="bg-body-tertiary">
    <main class="container py-5">
        <div class="row justify-content-center">
            @* A page with much text, for example the privacy policy, sets ViewData["Wide"] *@
            <div class="@(ViewData["Wide"] is true ? "col-lg-8" : "col-md-7 col-lg-5 col-xl-4")">
                <div class="text-center">
                    <partial name="_Branding" model="branding" />
                </div>
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        @RenderBody()
                    </div>
                </div>
                <div class="mt-3 text-center">
                    <partial name="_Disclaimer" />
                </div>
            </div>
        </div>
    </main>
</body>
</html>
