<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - CPDLC Server</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="@ViewData["BodyClass"]">
    <header class="bg-dark py-3">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <span class="fs-4 fw-semibold"><a href="/dashboard" class="text-white text-decoration-none">CPDLC Server</a></span>
            </div>
            <nav>
                <a href="/dashboard" class="text-white me-3">Dashboard</a>
                <a href="/dashboard/connections" class="text-white me-3">Connections</a>
                <a href="/dashboard/messages" class="text-white me-3">Messages</a>
                <a href="/" class="text-white">Documentation</a>
            </nav>
        </div>
    </header>
    <main class="mt-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
