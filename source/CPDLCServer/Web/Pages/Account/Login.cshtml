@page "/login"
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "_CenteredLayout";
}

<h1 class="h4 mb-3">Log in</h1>
<p class="text-muted">Log in with your VATSIM account.</p>

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <button type="submit" class="btn btn-primary w-100">Log in with VATSIM</button>
</form>

<p class="small text-muted mt-3 mb-0">
    When you log in, VATSIM gives this server your CID and your name.
    By logging in, you accept the <a href="/privacy">privacy policy</a>.
</p>
