@model CPDLCServer.Web.Pages.ViewModels.PaginationViewModel

@if (Model.TotalPages > 1)
{
    var startPage = Math.Max(1, Model.CurrentPage - 2);
    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    <nav aria-label="Pages" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Model.Url(Model.CurrentPage - 1)">Previous</a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item"><a class="page-link" href="@Model.Url(1)">1</a></li>
                if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @for (var i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Model.Url(i)" aria-current="@(i == Model.CurrentPage ? "page" : null)">@i</a>
                </li>
            }

            @if (endPage < Model.TotalPages)
            {
                if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item"><a class="page-link" href="@Model.Url(Model.TotalPages)">@Model.TotalPages</a></li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Model.Url(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
