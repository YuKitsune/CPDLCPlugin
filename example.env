# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Development

# Logging Configuration
Logging__Level=Debug

# ACARS Network Configuration
# Multiple configurations can be added by incrementing the index (0, 1, 2, etc.)

# First ACARS Configuration
Acars__0__Type=Hoppie
Acars__0__FlightSimulationNetwork=VATSIM
Acars__0__StationIdentifier=YBBB
Acars__0__Url=http://www.hoppie.nl/acars/system/connect.html
Acars__0__AuthenticationCode=your-authentication-code-here
# Reporting interval in minutes of the ADS-C contract requested on CPDLC logon (default: 10)
Acars__0__DefaultAdscReportingInterval=10
# Minutes from the request of a selected ADS-C contract to its end. Then the default contract is requested again (default: 60)
Acars__0__SelectedAdscContractDuration=60

# Example: Second ACARS Configuration (uncomment to use)
# Acars__1__Type=Hoppie
# Acars__1__FlightSimulationNetwork=IVAO
# Acars__1__StationIdentifier=KJFK
# Acars__1__Url=http://www.hoppie.nl/acars/system/connect.html
# Acars__1__AuthenticationCode=your-other-authentication-code

# Connection Monitoring Configuration
# The time in minutes between checks of the connected callsigns on the ACARS network (default: 15)
ConnectivityCheckIntervalMinutes=15
# The time (hh:mm:ss) without contact from an aircraft before its connection times out (default: 3 times ConnectivityCheckIntervalMinutes)
# Use a value of more than 2 times ConnectivityCheckIntervalMinutes. If not, one failed check will cause connections to time out.
AircraftConnectionTimeout=00:45:00

# Handoff Configuration
# How many minutes before the expected transfer time to send the NEXT DATA AUTHORITY message (default: 20)
Handoff__NotificationLeadTime=20

# ADS-C from VATSIM status data
# Make ADS-C reports from the VATSIM status data for aircraft that do not support ADS-C over Hoppie (default: false)
VatsimStatus__Enabled=false
# The time in seconds between downloads of the VATSIM status data (default: 120)
VatsimStatus__PollingIntervalSeconds=120
# Also make reports for aircraft that do not have D1 or G1 in Item 10b of the flight plan (default: false)
VatsimStatus__AllowNonEquippedAircraft=false

# ngrok auth token to allow remote connections to your local debug server
# https://ngrok.com/
# NGROK_AUTHTOKEN=TOKEN
