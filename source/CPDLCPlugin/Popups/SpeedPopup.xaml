<Popup x:Class="CPDLCPlugin.Popups.SpeedPopup"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:toolbox="clr-namespace:vatSysToolbox;assembly=vatSysToolbox"
       xmlns:toolboxControls="clr-namespace:vatSysToolbox.Controls;assembly=vatSysToolbox"
       xmlns:viewModels="clr-namespace:CPDLCPlugin.ViewModels"
       d:DataContext="{d:DesignInstance Type=viewModels:UplinkMessageTemplateElementComponentViewModel}"
       mc:Ignorable="d"
       Placement="Bottom"
       StaysOpen="False"
       AllowsTransparency="True">
    <Popup.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Popup.Resources>

    <Border Background="{toolbox:VatSysColour WindowBackground}">
        <toolboxControls:BeveledBorder BorderThickness="{x:Static toolboxControls:Bevel.BorderThickness}" BevelType="Outline">
            <!-- TODO: SPEED popup -->
            <TextBlock Text="SPEED" Margin="4"/>
        </toolboxControls:BeveledBorder>
    </Border>
</Popup>
