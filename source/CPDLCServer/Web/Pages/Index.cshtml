@page "/"
@model IndexModel
@{
    ViewData["Title"] = "CPDLC Server";
}

<h2>Dashboard</h2>

<div class="row mt-4 g-4">
    <div class="col-md-6 col-lg-3">
        <a href="#connections" class="text-decoration-none">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h3 class="display-4">@Model.Controllers.Length</h3>
                    <p class="text-muted mb-0">ATC Connections</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a href="#connections" class="text-decoration-none">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h3 class="display-4">@Model.Aircraft.Length</h3>
                    <p class="text-muted mb-0">Pilot Connections</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a href="#messages" class="text-decoration-none">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h3 class="display-4">@Model.TotalMessageCount</h3>
                    <p class="text-muted mb-0">Total Messages</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-3">
        <a href="#messages" class="text-decoration-none">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h3 class="display-4">@Model.OpenDialogueCount</h3>
                    <p class="text-muted mb-0">Open Dialogues</p>
                </div>
            </div>
        </a>
    </div>
</div>

<h3 id="connections" class="mt-5">Connections</h3>

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">ATC Connections</h5>
            </div>
            <div class="card-body">
                @if (Model.Controllers.Length == 0)
                {
                    <p class="text-muted">No ATC connections.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Callsign</th>
                                    <th>ATSU Code</th>
                                    <th>Connection ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var controller in Model.Controllers)
                                {
                                    <tr>
                                        <td><a href="/atsu/@controller.StationId">@controller.Callsign</a></td>
                                        <td>@controller.StationId</td>
                                        <td><code>@controller.ConnectionId</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Pilot Connections</h5>
            </div>
            <div class="card-body">
                @if (Model.Aircraft.Length == 0)
                {
                    <p class="text-muted">No pilot connections.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Callsign</th>
                                    <th>ATSU Code</th>
                                    <th>Data Authority</th>
                                    <th>ACARS Network</th>
                                    <th>Last Seen</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var aircraft in Model.Aircraft)
                                {
                                    <tr>
                                        <td><a href="/pilot/@aircraft.Callsign">@aircraft.Callsign</a></td>
                                        <td>@aircraft.StationId</td>
                                        <td>@aircraft.DataAuthorityState</td>
                                        <td>@aircraft.AcarsConnectionId</td>
                                        <td>@aircraft.LastSeen.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<h3 id="messages" class="mt-5">Messages</h3>

<div class="mt-3">
    <partial name="_MessageTable" model="Model.Messages" />
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Message pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/?pageNumber=@(Model.CurrentPage - 1)#messages">Previous</a>
            </li>

            @{
                var startPage = Math.Max(1, Model.CurrentPage - 2);
                var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="/?pageNumber=1#messages">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/?pageNumber=@(i)#messages">@i</a>
                    </li>
                }

                if (endPage < Model.TotalPages)
                {
                    if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="/?pageNumber=@(Model.TotalPages)#messages">@Model.TotalPages</a>
                    </li>
                }
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/?pageNumber=@(Model.CurrentPage + 1)#messages">Next</a>
            </li>
        </ul>
    </nav>
}
