# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Development

# Logging Configuration
Logging__Level=Debug

# Master Key (required)
# Encrypts the secrets in the database, for example the authentication codes of the ACARS connections.
# Make a key with: openssl rand -base64 32
# Keep the key safe. If the key changes, the server cannot decrypt the secrets, and you must enter them again.
MasterKey=your-master-key-here

# Data Directory
# The directory of the SQLite database (cpdlc.db). The server makes it if it does not exist.
# (default: .data at the root of the repository in Development, /data in other environments)
# DataPath=/data

# Database Configuration
# The database provider: Sqlite or PostgreSql (default: Sqlite)
# DatabaseProvider=Sqlite

# PostgreSQL: the connection string. A URL (postgresql://user:password@host:port/database?sslmode=require) is also accepted.
# DatabaseConnectionString=Host=localhost;Database=cpdlc;Username=cpdlc;Password=your-password

# ngrok auth token to allow remote connections to your local debug server
# https://ngrok.com/
# NGROK_AUTHTOKEN=TOKEN
