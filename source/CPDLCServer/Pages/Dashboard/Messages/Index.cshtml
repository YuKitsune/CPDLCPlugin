@page "/dashboard/messages"
@model CPDLCServer.Pages.Dashboard.Messages.IndexModel
@{
    ViewData["Title"] = "Messages";
}

<h2>Messages</h2>

<div class="mt-4">
    <partial name="_MessageTable" model="Model.Messages" />
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Message pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/dashboard/messages?pageNumber=@(Model.CurrentPage - 1)">Previous</a>
            </li>

            @{
                var startPage = Math.Max(1, Model.CurrentPage - 2);
                var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="/dashboard/messages?pageNumber=1">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/dashboard/messages?pageNumber=@i">@i</a>
                    </li>
                }

                if (endPage < Model.TotalPages)
                {
                    if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="/dashboard/messages?pageNumber=@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/dashboard/messages?pageNumber=@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
