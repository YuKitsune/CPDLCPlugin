@page "/setup"
@model IndexModel
@{
    ViewData["Title"] = "Setup";
    Layout = "_CenteredLayout";
}

<h1 class="h4 mb-3">Set up the server</h1>

@if (!Model.IsTokenValid)
{
    <div class="alert alert-warning mb-0" role="alert">
        <h2 class="h6 alert-heading">Open the setup URL from the server log</h2>
        <p class="mb-0">
            To protect the server, only a person who can read the server log can do the setup.
            When the server starts, it writes the setup URL to its log. The URL contains a token.
            Open that URL to continue.
        </p>
    </div>
}
else
{
    <p class="text-muted">You can do the setup only one time. You can change the operator details later in Configuration → Settings.</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form method="post">
        <input type="hidden" asp-for="Token" />

        <div class="mb-3">
            <label asp-for="Input.Cid" class="form-label fw-semibold"></label>
            <input asp-for="Input.Cid" type="text" class="form-control" inputmode="numeric" pattern="[0-9]+" autocomplete="username" autofocus />
            @if (Model.AuthOptions.IsVatsim)
            {
                <div class="form-text">The VATSIM CID of the first administrator. That person logs in with VATSIM and can add more administrators.</div>
            }
            else
            {
                <div class="form-text">The CID of the first administrator. That person logs in with this CID and the password, and can add more administrators.</div>
            }
            <span asp-validation-for="Input.Cid" class="text-danger small"></span>
        </div>

        @if (Model.AuthOptions.IsBuiltIn)
        {
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label fw-semibold"></label>
                <input asp-for="Input.Name" class="form-control" autocomplete="name" />
                <span asp-validation-for="Input.Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">Use 12 characters or more. Keep the password in a safe place. The server cannot show it again.</div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
        }

        <div class="mb-3">
            <label asp-for="Input.OperatorName" class="form-label fw-semibold"></label>
            <input asp-for="Input.OperatorName" class="form-control" autocomplete="organization" />
            <div class="form-text">The person or organisation that operates this server, for example a VATSIM division or FIR. The privacy policy shows it.</div>
            <span asp-validation-for="Input.OperatorName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.PrivacyContact" class="form-label fw-semibold"></label>
            <input asp-for="Input.PrivacyContact" class="form-control" autocomplete="email" />
            <div class="form-text">An email address or a URL. Users use it to ask questions about their data, or to ask you to delete it.</div>
            <span asp-validation-for="Input.PrivacyContact" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Complete the setup</button>
    </form>
}
