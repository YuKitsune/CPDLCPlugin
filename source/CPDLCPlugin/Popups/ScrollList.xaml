<UserControl x:Class="CPDLCPlugin.Popups.ScrollList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:CPDLCPlugin.ViewModels"
             xmlns:popups="clr-namespace:CPDLCPlugin.Popups">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The list shows exactly ItemCount items, and scrolls by one item at a time -->
    <ItemsControl x:Name="List"
                  ItemsSource="{Binding Options, RelativeSource={RelativeSource AncestorType=popups:ScrollList}}"
                  Height="{x:Static popups:ScrollList.ListHeight}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Item"
                  ScrollViewer.CanContentScroll="True">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer x:Name="ListScrollViewer"
                              Style="{StaticResource CustomScrollViewerStyle}"
                              CanContentScroll="True"
                              Padding="0"
                              Focusable="False">
                    <ItemsPresenter/>
                </ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type viewModels:ScrollListOption}">
                <!-- The default option is depressed -->
                <ToggleButton Content="{Binding Text}"
                              IsChecked="{Binding IsDefault, Mode=OneWay}"
                              Style="{StaticResource ToggleButtonBaseStyle}"
                              Height="{x:Static popups:ScrollList.ItemHeight}"
                              Margin="0"
                              Padding="0"
                              FocusVisualStyle="{x:Null}"
                              Click="OptionButton_Click"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
