@page "/configuration/settings"
@model IndexModel
@{
    ViewData["Title"] = "Settings";
}

<h1 class="h3">Settings</h1>
<p class="text-muted mb-4">The server applies the changes immediately. A restart is not necessary.</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form method="post">
    <div class="card mt-3">
        <div class="card-header fw-semibold">Branding</div>
        <div class="card-body">
            <p class="form-text mt-0">The name, banner and message of the day show at the top of the sidebar and on the login page.</p>

            <div class="row py-2 border-bottom">
                <div class="col-md-5">
                    <label asp-for="Settings.ServerName" class="form-label fw-semibold">Server name</label>
                    <div class="form-text">Shows in the browser tab, and in the sidebar when there is no banner.</div>
                </div>
                <div class="col-md-5">
                    <div class="input-group">
                        <input asp-for="Settings.ServerName" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" data-reset-for="Settings_ServerName" data-default-value="@Model.Defaults.ServerName">Reset</button>
                    </div>
                    <span asp-validation-for="Settings.ServerName" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-text">Default: @Model.Defaults.ServerName</div>
            </div>

            <div class="row py-2 border-bottom">
                <div class="col-md-5">
                    <label asp-for="Settings.Motd" class="form-label fw-semibold">Message of the day</label>
                    <div class="form-text">Optional. Plain text. The line breaks are kept.</div>
                </div>
                <div class="col-md-5">
                    <textarea asp-for="Settings.Motd" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Settings.Motd" class="text-danger small"></span>
                </div>
            </div>

            <div class="row py-2">
                <div class="col-md-5">
                    <label for="banner" class="form-label fw-semibold">Banner</label>
                    <div class="form-text">Optional. PNG, JPEG or WebP, 1 MB or less. The sidebar is 16rem wide, so a wide image is best. The banner changes when you upload it. The Save button does not change it.</div>
                </div>
                <div class="col-md-5">
                    @if (Model.Branding.HasBanner)
                    {
                        <div class="mb-2 p-2 border rounded bg-body-tertiary" style="max-width: 16rem;">
                            <img src="/branding/banner?v=@Model.Branding.BannerVersion" alt="Current banner" class="img-fluid" />
                        </div>
                    }

                    @* These controls are in the banner forms below the settings form, because a form cannot contain a form *@
                    <input id="banner" name="banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" form="banner-upload-form" required />
                    @Html.ValidationMessage("Banner", null, new { @class = "text-danger small" })
                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-sm btn-outline-primary" form="banner-upload-form">Upload</button>
                        @if (Model.Branding.HasBanner)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-danger" form="banner-remove-form">Remove</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header fw-semibold">Operator</div>
        <div class="card-body">
            <p class="form-text mt-0">The <a href="/privacy">privacy policy</a> shows the operator and the contact.</p>

            <div class="row py-2 border-bottom">
                <div class="col-md-5">
                    <label asp-for="Settings.OperatorName" class="form-label fw-semibold">Operator name</label>
                    <div class="form-text">The person or organisation that operates this server, for example a VATSIM division or FIR.</div>
                </div>
                <div class="col-md-5">
                    <input asp-for="Settings.OperatorName" class="form-control" />
                    <span asp-validation-for="Settings.OperatorName" class="text-danger small"></span>
                </div>
            </div>

            <div class="row py-2">
                <div class="col-md-5">
                    <label asp-for="Settings.PrivacyContact" class="form-label fw-semibold">Privacy contact</label>
                    <div class="form-text">An email address or a URL. Users use it to ask questions about their data, or to ask you to delete it.</div>
                </div>
                <div class="col-md-5">
                    <input asp-for="Settings.PrivacyContact" class="form-control" />
                    <span asp-validation-for="Settings.PrivacyContact" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header fw-semibold">Connections</div>
        <div class="card-body">
            @if (Model.OneFailedCheckCausesTimeout)
            {
                <div class="alert alert-warning" role="alert">
                    The aircraft connection timeout is not more than two times the connectivity check interval. One failed check will cause connections to time out.
                </div>
            }

            <div class="row py-2 border-bottom">
                <div class="col-md-5">
                    <label asp-for="Settings.ConnectivityCheckIntervalMinutes" class="form-label fw-semibold">Connectivity check interval</label>
                    <div class="form-text">The time between checks of the connected callsigns on the ACARS network.</div>
                </div>
                <div class="col-md-5">
                    <div class="input-group">
                        <input asp-for="Settings.ConnectivityCheckIntervalMinutes" class="form-control" min="1" />
                        <span class="input-group-text">minutes</span>
                        <button type="button" class="btn btn-outline-secondary" data-reset-for="Settings_ConnectivityCheckIntervalMinutes" data-default-value="@Model.Defaults.ConnectivityCheckIntervalMinutes">Reset</button>
                    </div>
                    <span asp-validation-for="Settings.ConnectivityCheckIntervalMinutes" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-text">Default: @Model.Defaults.ConnectivityCheckIntervalMinutes minutes</div>
            </div>

            <div class="row py-2">
                <div class="col-md-5">
                    <label asp-for="Settings.AircraftConnectionTimeoutMinutes" class="form-label fw-semibold">Aircraft connection timeout</label>
                    <div class="form-text">The time without contact from an aircraft before its connection times out. Use a value of more than two times the connectivity check interval. If not, one failed check will cause connections to time out.</div>
                </div>
                <div class="col-md-5">
                    <div class="input-group">
                        <input asp-for="Settings.AircraftConnectionTimeoutMinutes" class="form-control" min="1" />
                        <span class="input-group-text">minutes</span>
                        <button type="button" class="btn btn-outline-secondary" data-reset-for="Settings_AircraftConnectionTimeoutMinutes" data-default-value="@Model.Defaults.AircraftConnectionTimeoutMinutes">Reset</button>
                    </div>
                    <span asp-validation-for="Settings.AircraftConnectionTimeoutMinutes" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-text">Default: @Model.Defaults.AircraftConnectionTimeoutMinutes minutes</div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header fw-semibold">Dialogues</div>
        <div class="card-body">
            <div class="row py-2">
                <div class="col-md-5">
                    <label asp-for="Settings.DialogueRetentionHours" class="form-label fw-semibold">Dialogue retention</label>
                    <div class="form-text">The time from when a dialogue opens until the server deletes it. The server keeps the dialogues after the aircraft disconnects.</div>
                </div>
                <div class="col-md-5">
                    <div class="input-group">
                        <input asp-for="Settings.DialogueRetentionHours" class="form-control" min="1" />
                        <span class="input-group-text">hours</span>
                        <button type="button" class="btn btn-outline-secondary" data-reset-for="Settings_DialogueRetentionHours" data-default-value="@Model.Defaults.DialogueRetentionHours">Reset</button>
                    </div>
                    <span asp-validation-for="Settings.DialogueRetentionHours" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-text">Default: @Model.Defaults.DialogueRetentionHours hours</div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header fw-semibold">ADS-C</div>
        <div class="card-body">
            <div class="row py-2">
                <div class="col-md-5">
                    <label asp-for="Settings.AdscContractTimeoutMinutes" class="form-label fw-semibold">ADS-C contract timeout</label>
                    <div class="form-text">The time without ADS-C activity from an aircraft before the server cancels the ADS-C contract.</div>
                </div>
                <div class="col-md-5">
                    <div class="input-group">
                        <input asp-for="Settings.AdscContractTimeoutMinutes" class="form-control" min="1" />
                        <span class="input-group-text">minutes</span>
                        <button type="button" class="btn btn-outline-secondary" data-reset-for="Settings_AdscContractTimeoutMinutes" data-default-value="@Model.Defaults.AdscContractTimeoutMinutes">Reset</button>
                    </div>
                    <span asp-validation-for="Settings.AdscContractTimeoutMinutes" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-text">Default: @Model.Defaults.AdscContractTimeoutMinutes minutes</div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header fw-semibold">Handoff</div>
        <div class="card-body">
            <div class="row py-2">
                <div class="col-md-5">
                    <label asp-for="Settings.HandoffNotificationLeadTimeMinutes" class="form-label fw-semibold">Handoff notification lead time</label>
                    <div class="form-text">The time before the expected transfer time to send the NEXT DATA AUTHORITY message.</div>
                </div>
                <div class="col-md-5">
                    <div class="input-group">
                        <input asp-for="Settings.HandoffNotificationLeadTimeMinutes" class="form-control" min="0" />
                        <span class="input-group-text">minutes</span>
                        <button type="button" class="btn btn-outline-secondary" data-reset-for="Settings_HandoffNotificationLeadTimeMinutes" data-default-value="@Model.Defaults.HandoffNotificationLeadTimeMinutes">Reset</button>
                    </div>
                    <span asp-validation-for="Settings.HandoffNotificationLeadTimeMinutes" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-text">Default: @Model.Defaults.HandoffNotificationLeadTimeMinutes minutes</div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header fw-semibold">ADS-C from VATSIM status data</div>
        <div class="card-body">
            <div class="row py-2 border-bottom">
                <div class="col-md-5">
                    <label asp-for="Settings.VatsimStatusEnabled" class="form-label fw-semibold">Enabled</label>
                    <div class="form-text">Make ADS-C reports from the VATSIM status data for aircraft that do not support ADS-C over Hoppie.</div>
                </div>
                <div class="col-md-5 d-flex align-items-center">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="Settings.VatsimStatusEnabled" class="form-check-input" role="switch" />
                    </div>
                </div>
                <div class="col-md-2 form-text">Default: @(Model.Defaults.VatsimStatusEnabled ? "On" : "Off")</div>
            </div>

            <div class="row py-2 border-bottom">
                <div class="col-md-5">
                    <label asp-for="Settings.VatsimStatusUrl" class="form-label fw-semibold">URL</label>
                    <div class="form-text">The URL of the VATSIM status data.</div>
                </div>
                <div class="col-md-5">
                    <div class="input-group">
                        <input asp-for="Settings.VatsimStatusUrl" type="url" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" data-reset-for="Settings_VatsimStatusUrl" data-default-value="@Model.Defaults.VatsimStatusUrl">Reset</button>
                    </div>
                    <span asp-validation-for="Settings.VatsimStatusUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-text text-break">Default: @Model.Defaults.VatsimStatusUrl</div>
            </div>

            <div class="row py-2 border-bottom">
                <div class="col-md-5">
                    <label asp-for="Settings.VatsimStatusPollingIntervalSeconds" class="form-label fw-semibold">Polling interval</label>
                    <div class="form-text">The time between downloads of the VATSIM status data.</div>
                </div>
                <div class="col-md-5">
                    <div class="input-group">
                        <input asp-for="Settings.VatsimStatusPollingIntervalSeconds" class="form-control" min="1" />
                        <span class="input-group-text">seconds</span>
                        <button type="button" class="btn btn-outline-secondary" data-reset-for="Settings_VatsimStatusPollingIntervalSeconds" data-default-value="@Model.Defaults.VatsimStatusPollingIntervalSeconds">Reset</button>
                    </div>
                    <span asp-validation-for="Settings.VatsimStatusPollingIntervalSeconds" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-text">Default: @Model.Defaults.VatsimStatusPollingIntervalSeconds seconds</div>
            </div>

            <div class="row py-2 border-bottom">
                <div class="col-md-5">
                    <label asp-for="Settings.VatsimStatusReportDelayMinutes" class="form-label fw-semibold">Report delay</label>
                    <div class="form-text">The time after a new ADS-C contract before VATSIM reports are made. During this time, the aircraft can send its first report through Hoppie.</div>
                </div>
                <div class="col-md-5">
                    <div class="input-group">
                        <input asp-for="Settings.VatsimStatusReportDelayMinutes" class="form-control" min="0" />
                        <span class="input-group-text">minutes</span>
                        <button type="button" class="btn btn-outline-secondary" data-reset-for="Settings_VatsimStatusReportDelayMinutes" data-default-value="@Model.Defaults.VatsimStatusReportDelayMinutes">Reset</button>
                    </div>
                    <span asp-validation-for="Settings.VatsimStatusReportDelayMinutes" class="text-danger small"></span>
                </div>
                <div class="col-md-2 form-text">Default: @Model.Defaults.VatsimStatusReportDelayMinutes minutes</div>
            </div>

            <div class="row py-2">
                <div class="col-md-5">
                    <label asp-for="Settings.VatsimStatusAllowNonEquippedAircraft" class="form-label fw-semibold">Allow aircraft without ADS-C equipment</label>
                    <div class="form-text">Also make reports for aircraft that do not have D1 or G1 in Item 10b of the flight plan.</div>
                </div>
                <div class="col-md-5 d-flex align-items-center">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="Settings.VatsimStatusAllowNonEquippedAircraft" class="form-check-input" role="switch" />
                    </div>
                </div>
                <div class="col-md-2 form-text">Default: @(Model.Defaults.VatsimStatusAllowNonEquippedAircraft ? "On" : "Off")</div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 my-4">
        <a href="/configuration/settings" class="btn btn-outline-secondary">Discard changes</a>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>

<form id="banner-upload-form" method="post" asp-page-handler="UploadBanner" enctype="multipart/form-data"></form>
<form id="banner-remove-form" method="post" asp-page-handler="RemoveBanner"></form>

@section Scripts {
    <script>
        // A reset button only changes the value in the form. The value is saved with the Save button.
        document.querySelectorAll('[data-reset-for]').forEach(button => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.resetFor);
                input.value = button.dataset.defaultValue;
            });
        });
    </script>
}
