@page "/dashboard/atsu/{stationId}"
@model CPDLCServer.Pages.Dashboard.Atsu.IndexModel
@{
    ViewData["Title"] = $"ATSU {Model.StationId}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/dashboard/connections">Connections</a></li>
        <li class="breadcrumb-item active" aria-current="page">ATSU</li>
    </ol>
</nav>

<h2>ATSU: @Model.StationId</h2>

@if (Model.Controllers.Length > 0)
{
    <div class="card mt-3">
        <div class="card-header">
            <h5 class="mb-0">Active Controllers</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Callsign</th>
                            <th>Connection ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var controller in Model.Controllers)
                        {
                            <tr>
                                <td>@controller.Callsign</td>
                                <td><code>@controller.ConnectionId</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary mt-3">No active controllers at this ATSU.</div>
}

<h3 class="mt-4">Messages</h3>

<div class="mt-3">
    <partial name="_MessageTable" model="Model.Messages" />
</div>
