@page "/adsc"
@using CPDLCServer.Model
@model CPDLCServer.Pages.Dashboard.Adsc.IndexModel
@{
    ViewData["Title"] = "ADS-C";

    string FormatInterval(TimeSpan? interval) => interval is null ? "-" : $"{interval.Value.TotalMinutes:0.#} min";

    string GetStateBadgeClass(AdscContractState? state) => state switch
    {
        AdscContractState.Sent => "bg-info",
        AdscContractState.Accepted => "bg-success",
        AdscContractState.Rejected => "bg-danger",
        _ => "bg-light text-dark"
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">ADS-C</li>
    </ol>
</nav>

<h2>ADS-C</h2>

<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Contracts</h5>
    </div>
    <div class="card-body">
        @if (Model.Contracts.Length == 0)
        {
            <p class="text-muted">No ADS-C contracts.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Callsign</th>
                            <th>ATSU Code</th>
                            <th>Current Interval</th>
                            <th>Default</th>
                            <th>Selected Interval</th>
                            <th>Selected</th>
                            <th>Selected Ends</th>
                            <th>Demand</th>
                            <th>Report Source</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in Model.Contracts)
                        {
                            <tr>
                                <td><a href="/pilot/@contract.Callsign">@contract.Callsign</a></td>
                                <td><a href="/atsu/@contract.StationId">@contract.StationId</a></td>
                                <td>@FormatInterval(contract.ReportingInterval)</td>
                                <td><span class="badge @GetStateBadgeClass(contract.DefaultContractState)">@(contract.DefaultContractState?.ToString() ?? "-")</span></td>
                                <td>@FormatInterval(contract.SelectedReportingInterval)</td>
                                <td><span class="badge @GetStateBadgeClass(contract.SelectedContractState)">@(contract.SelectedContractState?.ToString() ?? "-")</span></td>
                                <td>@(contract.SelectedContractEnds?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                                <td><span class="badge @GetStateBadgeClass(contract.DemandContractState)">@(contract.DemandContractState?.ToString() ?? "-")</span></td>
                                <td>@(Model.ReportSources.TryGetValue(contract.Callsign, out var source) ? source.ToString() : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Message Log</h5>
    </div>
    <div class="card-body">
        @if (Model.LogEntries.Length == 0)
        {
            <p class="text-muted">No ADS-C messages.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Timestamp</th>
                            <th>Network</th>
                            <th>Dir</th>
                            <th>ATSU Code</th>
                            <th>Callsign</th>
                            <th>Packet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.LogEntries)
                        {
                            <tr>
                                <td>@entry.Time.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@entry.AcarsClientId</td>
                                <td>@(entry.Direction == AdscMessageDirection.Uplink ? "↑" : "↓")</td>
                                <td>@entry.StationId</td>
                                <td>@entry.Callsign</td>
                                <td><code>@entry.Packet</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Message log pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/adsc?pageNumber=@(Model.CurrentPage - 1)">Previous</a>
            </li>

            @{
                var startPage = Math.Max(1, Model.CurrentPage - 2);
                var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="/adsc?pageNumber=1">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/adsc?pageNumber=@i">@i</a>
                    </li>
                }

                if (endPage < Model.TotalPages)
                {
                    if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="/adsc?pageNumber=@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/adsc?pageNumber=@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
