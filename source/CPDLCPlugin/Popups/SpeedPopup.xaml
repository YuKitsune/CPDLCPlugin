<UserControl x:Class="CPDLCPlugin.Popups.SpeedPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:toolbox="clr-namespace:vatSysToolbox;assembly=vatSysToolbox"
             xmlns:viewModels="clr-namespace:CPDLCPlugin.ViewModels"
             xmlns:popups="clr-namespace:CPDLCPlugin.Popups"
             d:DataContext="{d:DesignInstance Type=viewModels:SpeedPopupViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Width="80" Background="{toolbox:VatSysColour WindowBackground}">
        <!-- ACID -->
        <Border BorderBrush="{toolbox:VatSysColour GenericText}"
                BorderThickness="2"
                Height="{x:Static popups:ScrollList.ItemHeight}">
            <TextBlock Text="{Binding Callsign}"
                       Style="{StaticResource GenericTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <popups:ScrollList Options="{Binding Options}" SelectCommand="{Binding SelectCommand}"/>

        <!-- Unit. It is depressed when the speeds are in Mach. -->
        <ToggleButton Content="{Binding UnitText}"
                      IsChecked="{Binding IsMach}"
                      Style="{StaticResource ToggleButtonBaseStyle}"
                      Height="{x:Static popups:ScrollList.ItemHeight}"
                      Margin="0"
                      Padding="0"
                      FocusVisualStyle="{x:Null}"/>
    </StackPanel>
</UserControl>
