@page "/account/password"
@model PasswordModel
@{
    ViewData["Title"] = "Change password";
}

<h1 class="h3">Change password</h1>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form method="post" class="col-lg-6">
    <div class="card">
        <div class="card-body">
            <input type="text" name="username" value="@User.GetCid()" autocomplete="username" hidden />

            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label fw-semibold"></label>
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" autofocus />
                <div class="form-text">Use 12 characters or more.</div>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-0">
                <label asp-for="Input.ConfirmNewPassword" class="form-label fw-semibold"></label>
                <input asp-for="Input.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmNewPassword" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end my-4">
        <button type="submit" class="btn btn-primary">Change password</button>
    </div>
</form>
