<Window x:Class="CPDLCPlugin.Windows.ADSContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CPDLCPlugin"
        xmlns:viewModels="clr-namespace:CPDLCPlugin.ViewModels"
        xmlns:controls="clr-namespace:CPDLCPlugin.Controls"
        xmlns:converters="clr-namespace:CPDLCPlugin.Converters"
        Background="{x:Static local:Theme.BackgroundColor}"
        d:DataContext="{d:DesignInstance Type=viewModels:ADSContractViewModel, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        Title="ADS CONTRACT WINDOW"
        Height="220"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CPDLCPlugin;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:AdscContractStateToSymbolConverter x:Key="AdscContractStateToSymbolConverter"/>
            <converters:TimeConverter x:Key="TimeConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>

            <!-- Callsign -->
            <TextBlock Grid.Column="0"
                       Style="{StaticResource GenericTextStyle}"
                       Margin="0,0,8,0"
                       Text="ACID:"/>

            <Grid Grid.Column="1" Width="120" Height="32">
                <TextBox x:Name="CallsignTextBox"
                         CharacterCasing="Upper"
                         Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         KeyDown="CallsignTextBox_KeyDown"
                         Visibility="Collapsed"/>

                <Button x:Name="CallsignButton"
                        Content="{Binding CallsignButtonText}"
                        Click="CallsignButton_Click"
                        Style="{StaticResource ButtonBaseStyle}"/>
            </Grid>

            <!-- Current Period -->
            <TextBlock Grid.Column="2"
                       Style="{StaticResource GenericTextStyle}"
                       HorizontalAlignment="Right"
                       Margin="16,0,16,0"
                       Text="Current Period"/>

            <Border
                Grid.Column="3"
                BorderBrush="{x:Static local:Theme.GenericTextColor}"
                BorderThickness="1"
                Height="32">
                <TextBlock
                   Style="{StaticResource GenericTextStyle}"
                   Margin="0,0,8,0"
                   HorizontalAlignment="Center"
                   Text="{Binding CurrentPeriodMinutes}"/>
            </Border>

            <!-- Last Report -->
            <TextBlock Grid.Column="4"
                       Style="{StaticResource GenericTextStyle}"
                       HorizontalAlignment="Right"
                       Margin="16,0,16,0"
                       Text="Last Report"/>

            <Border
                Grid.Column="5"
                BorderBrush="{x:Static local:Theme.GenericTextColor}"
                BorderThickness="1"
                Height="32">
                <TextBlock
                    Style="{StaticResource GenericTextStyle}"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Center"
                    Text="{Binding LastReport, Converter={StaticResource TimeConverter}}"/>
            </Border>
        </Grid>

        <controls:BeveledLine Grid.Row="1" Height="{x:Static local:Theme.BeveledLineWidth}" Orientation="Horizontal" Flipped="true"/>

        <!-- Period Details -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Default Period -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Style="{StaticResource GenericTextStyle}"
                       Margin="0,0,32,0"
                       Text="Default Period"/>

            <TextBlock Grid.Row="0" Grid.Column="1"
                       Style="{StaticResource GenericTextStyle}"
                       Text="{Binding DefaultPeriodTransmissionState, Converter={StaticResource AdscContractStateToSymbolConverter}}"/>

            <Border Grid.Row="0" Grid.Column="2"
                BorderBrush="{x:Static local:Theme.GenericTextColor}"
                BorderThickness="1"
                Height="32">
                <TextBlock
                    Style="{StaticResource GenericTextStyle}"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Center"
                    Text="{Binding DefaultPeriod}"/>
            </Border>

            <!-- Selected Period -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Style="{StaticResource GenericTextStyle}"
                       Margin="0,0,32,0"
                       Text="Selected Period"/>

            <TextBlock Grid.Row="1" Grid.Column="1"
                       Style="{StaticResource GenericTextStyle}"
                       Text="{Binding SelectedPeriodTransmissionState, Converter={StaticResource AdscContractStateToSymbolConverter}}"/>

            <Button x:Name="SelectedPeriodButton"
                    Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource ButtonBaseStyle}"
                    Height="24"
                    Content="{Binding SelectedPeriodButtonText}"
                    Click="SelectedPeriodButton_Click"/>

            <!-- Period Popup -->
            <Popup x:Name="PeriodPopup"
                   PlacementTarget="{Binding ElementName=SelectedPeriodButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="{x:Static local:Theme.BackgroundColor}">
                    <controls:BeveledBorder BorderThickness="{x:Static local:Theme.BeveledBorderThickness}" BevelType="Outline">
                        <StackPanel>
                           <StackPanel>
                                <Button Style="{StaticResource ButtonBaseStyle}"
                                        Height="24"
                                        Content="DEF"
                                        Command="{Binding SelectPeriodCommand}"
                                        Click="PeriodButton_Click"/>

                                <ItemsControl ItemsSource="{Binding PeriodOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ButtonBaseStyle}"
                                                    Height="24"
                                                    Content="{Binding}"
                                                    Command="{Binding DataContext.SelectPeriodCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Click="PeriodButton_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <controls:TextInput x:Name="CustomPeriodInput"
                                                MaxCharacters="2"
                                                DigitsOnly="True"
                                                KeyDown="CustomPeriodInput_KeyDown"/>
                        </StackPanel>
                    </controls:BeveledBorder>
                </Border>
            </Popup>

            <!-- Selected Period End -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Style="{StaticResource GenericTextStyle}"
                       Margin="0,0,32,0"
                       Text="Selected Period End"/>

            <Border Grid.Row="2" Grid.Column="2"
                    BorderBrush="{x:Static local:Theme.GenericTextColor}"
                    BorderThickness="1"
                    Height="32">
                <TextBlock
                    Style="{StaticResource GenericTextStyle}"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Center"
                    Text="{Binding SelectedPeriodEndTime, Converter={StaticResource TimeConverter}}"/>
            </Border>

            <!-- Demand contract -->
            <Grid Grid.Row="0" Grid.Column="3" Grid.RowSpan="3" Margin="16,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource GenericTextStyle}"
                           HorizontalAlignment="Center"
                           Text="{Binding DemandContractTransmissionState, Converter={StaticResource AdscContractStateToSymbolConverter}}"/>

                <Button Grid.Column="1"
                        Style="{StaticResource ButtonBaseStyle}"
                        Width="80" Height="48"
                        HorizontalAlignment="Left"
                        Command="{Binding RequestDemandReportCommand}">
                    <TextBlock Text="Demand Contract" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
