@page "/settings/users/{id:guid}/password"
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/settings">Settings</a></li>
        <li class="breadcrumb-item"><a asp-page="Index">Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">Change password</li>
    </ol>
</nav>

<h2>Change password</h2>
<p class="text-muted">Set a new password for <strong>@Model.Username</strong>. The current password is not necessary.</p>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form method="post" class="col-lg-8">
    <div class="card">
        <div class="card-body">
            <input type="text" name="username" value="@Model.Username" autocomplete="username" hidden />

            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label fw-semibold"></label>
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" autofocus />
                <div class="form-text">Use 12 characters or more.</div>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-0">
                <label asp-for="Input.ConfirmNewPassword" class="form-label fw-semibold"></label>
                <input asp-for="Input.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmNewPassword" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 my-4">
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Change password</button>
    </div>
</form>
