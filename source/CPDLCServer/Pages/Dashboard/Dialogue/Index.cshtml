@page "/dashboard/dialogue/{id:guid}"
@model CPDLCServer.Pages.Dashboard.Dialogue.IndexModel
@{
    ViewData["Title"] = $"Dialogue {Model.Dialogue?.Id.ToString()[..8]}...";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/dashboard/messages">Messages</a></li>
        <li class="breadcrumb-item active" aria-current="page">Dialogue</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center">
    <h2>Dialogue</h2>
    <span class="badge @(Model.Dialogue?.IsClosed == true ? "bg-secondary" : "bg-success") fs-6">
        @(Model.Dialogue?.IsClosed == true ? "Closed" : "Open")
    </span>
</div>

<div class="card mt-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Dialogue ID</dt>
            <dd class="col-sm-9"><code>@Model.Dialogue?.Id</code></dd>

            <dt class="col-sm-3">Aircraft</dt>
            <dd class="col-sm-9"><a href="/dashboard/pilot/@Model.Dialogue?.AircraftCallsign">@Model.Dialogue?.AircraftCallsign</a></dd>

            <dt class="col-sm-3">ATSU</dt>
            <dd class="col-sm-9"><a href="/dashboard/atsu/@Model.StationId">@Model.StationId</a></dd>

            <dt class="col-sm-3">ACARS Network</dt>
            <dd class="col-sm-9">@Model.AcarsNetwork</dd>

            <dt class="col-sm-3">Opened</dt>
            <dd class="col-sm-9">@Model.Dialogue?.Opened.ToString("yyyy-MM-dd HH:mm:ss")</dd>

            @if (Model.Dialogue?.IsClosed == true)
            {
                <dt class="col-sm-3">Closed</dt>
                <dd class="col-sm-9">@Model.Dialogue?.Closed?.ToString("yyyy-MM-dd HH:mm:ss")</dd>
            }
        </dl>
    </div>
</div>

<h3 class="mt-4">Messages</h3>

<div class="mt-3">
    <partial name="_MessageTable" model="Model.Messages" />
</div>
